# Task data storage directory
# On Vercel: use /tmp (ephemeral — data lost between function invocations)
# Self-hosted: set to a persistent path, e.g. /var/lib/taskgeneral
TASKGENERAL_DATA_DIR=/tmp/taskgeneral

# Server listen port (standalone binary only — Vercel ignores this)
TASKGENERAL_PORT=8080

# Path to built frontend assets (standalone binary only — Vercel serves frontend separately)
TASKGENERAL_STATIC_DIR=./frontend/dist

# ---------------------------------------------------------------------------
# Neon — Database (persistent PostgreSQL storage)
# ---------------------------------------------------------------------------

# PostgreSQL connection string from Neon.
# Use the pooled connection string for production (Neon dashboard → Connection Details → Pooled connection).
# For local dev you can use either pooled or direct — both work over IPv4/IPv6.
# Neon dashboard → Your project → Connection Details
DATABASE_URL=postgresql://[user]:[password]@[host].neon.tech/[dbname]?sslmode=require

# ---------------------------------------------------------------------------
# Supabase — Auth only (JWT validation + frontend login/signup)
# ---------------------------------------------------------------------------

# Supabase project URL — used by the backend to fetch the JWKS endpoint for
# ES256 JWT validation, and by the frontend Supabase JS SDK.
# Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://[project-ref].supabase.co

# JWT secret — used as a fallback for local dev/testing (HS256).
# Dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ---------------------------------------------------------------------------
# Supabase — Frontend (Vite public env vars, safe to expose to the browser)
# ---------------------------------------------------------------------------

# Must match SUPABASE_URL above.
VITE_SUPABASE_URL=https://[project-ref].supabase.co

# Anon/public key — safe to expose; scoped to public RLS policies only.
# Dashboard → Project Settings → API → Project API keys → anon / public
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
